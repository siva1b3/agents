PORT=3000

# OpenAI
OPENAI_MODEL=gpt-4o

# PostgreSQL
# Use localhost because your Node process runs on the host machine,
# not inside Docker. Port 5432 is already mapped to the host.
PG_HOST=agent_app_postgres_service_container
PG_PORT=5432
PG_USER=admin_user
PG_PASSWORD=admin_password
PG_DATABASE=agent_app_db